{
  "mcpServers": {
    "db": {
      "command": "uvx",
      "args": [
        "--python", "3.12",
        "--overrides", "postgres-mcp-overrides.txt",
        "postgres-mcp==0.3.0",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${DATABASE_URI}"
      }
    }
  }
}
